# Copy to .env and fill in. Never commit .env.

# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=REPLACE_ME_fernet_key_placeholder

# Generate with: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=REPLACE_ME_session_secret_placeholder

# Swap to postgresql+asyncpg://user:pass@host/db later; no code changes needed.
DATABASE_URL=sqlite+aiosqlite:///./ccc.db

# Used to build OAuth redirect URIs: {BASE_URL}/auth/{provider}/callback
BASE_URL=http://localhost:8000

# Phase 1 has no login; this seeded user is the "current" user.
SEED_USER_EMAIL=test@example.com

# https://www.strava.com/settings/api  (Authorization Callback Domain: localhost)
STRAVA_CLIENT_ID=fake-strava-client-id
STRAVA_CLIENT_SECRET=fake-strava-client-secret

# Issued manually by the Intervals.icu developer
INTERVALS_CLIENT_ID=fake-intervals-client-id
INTERVALS_CLIENT_SECRET=fake-intervals-client-secret
